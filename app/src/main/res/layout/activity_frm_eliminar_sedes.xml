<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#29224E" android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Vista.frmEliminarSedes">

    <TextView
        android:id="@+id/tvTituloEliminarSedes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Eliminar Sedes"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="313dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloEliminarSedes"
        app:layout_constraintVertical_bias="0.3">

        <TextView
            android:id="@+id/textView65"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Codigo:"
            android:textColor="#FFFFFF" android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/txtCodigoSedeEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:background="@drawable/input_border" android:padding="12dp" android:textColor="#FFFFFF" android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/button76"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="btnEliminarSede"
            android:text="Eliminar Sede"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/button77"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="btnRegresar"
            android:text="Regresar" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>