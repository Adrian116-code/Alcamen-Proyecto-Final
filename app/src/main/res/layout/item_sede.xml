<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#2A2450"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Barra vertical de acento azul/cyan para Sedes -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#0EA5E9"
            android:layout_marginEnd="12dp" />

        <!-- Datos de la Sede -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nombre de la Sede -->
            <TextView
                android:id="@+id/tvNombreSede"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sede Central - Lima"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Dirección -->
            <TextView
                android:id="@+id/tvDireccionSede"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Av. Los Olivos 123"
                android:textColor="#A78BFA"
                android:textSize="14sp" />

            <!-- Código -->
            <TextView
                android:id="@+id/tvCodigoSede"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Código: SEDE001"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>