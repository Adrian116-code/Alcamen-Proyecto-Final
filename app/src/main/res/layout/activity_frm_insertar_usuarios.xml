<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1B4B"
    tools:context=".Vista.frmInsertarUsuarios">

    <TextView
        android:id="@+id/headerInsertarUsuarios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:text="Insertar Usuario"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"/>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/headerInsertarUsuarios"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="40dp">

            <EditText
                android:id="@+id/txtCodigoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_border"
                android:ems="10"
                android:hint="Código:"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="12dp"
                android:textColor="#000000"
                android:textColorHint="#888888" />

            <EditText
                android:id="@+id/txtDni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_border"
                android:ems="10"
                android:hint="DNI:"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="12dp"
                android:textColor="#000000"
                android:textColorHint="#888888" />

            <EditText
                android:id="@+id/txtNombres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_border"
                android:ems="10"
                android:hint="Nombres:"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="12dp"
                android:textColor="#000000"
                android:textColorHint="#888888" />

            <EditText
                android:id="@+id/txtApellidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_border"
                android:ems="10"
                android:hint="Apellidos:"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="12dp"
                android:textColor="#000000"
                android:textColorHint="#888888" />

            <EditText
                android:id="@+id/txtEdad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_border"
                android:ems="10"
                android:hint="Edad"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="12dp"
                android:textColor="#000000"
                android:textColorHint="#888888" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/txtRolMod"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Selecciona un Rol"
                android:textColorHint="#B0B0B0"
                app:boxStrokeColor="#FFFFFF"
                app:endIconTint="#FFFFFF"
                app:hintTextColor="#FFFFFF">

                <AutoCompleteTextView
                    android:id="@+id/txtrol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:editable="false"
                    android:inputType="none"
                    android:paddingStart="16dp"
                    android:paddingLeft="16dp"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <EditText
                android:id="@+id/txtUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_border"
                android:ems="10"
                android:hint="Username"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="12dp"
                android:textColor="#000000"
                android:textColorHint="#888888" />

            <EditText
                android:id="@+id/txtPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_border"
                android:ems="10"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="12dp"
                android:textColor="#000000"
                android:textColorHint="#888888" />

            <Button
                android:id="@+id/button27"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:onClick="btnInsertarUsuario"
                android:text="Insertar Usuario" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="#1F1A3D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUsuarios"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="Usuarios"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:backgroundTint="#3A3266"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_people"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProductos"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Productos"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_inventory"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSedes"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Sedes"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_location_city"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Regresar"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

    </LinearLayout>

</RelativeLayout>