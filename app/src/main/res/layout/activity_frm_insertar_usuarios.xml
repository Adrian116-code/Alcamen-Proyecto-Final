<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#1E1B4B">

    <!-- ==================== HEADER (FIJO ARRIBA) ==================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/headerInsertarUsuarios"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="#5C429B"
        app:title="Insertar Usuarios"
        app:titleCentered="true"
        app:titleTextAppearance="@style/ToolbarTitleStyle"
        app:titleTextColor="@android:color/white" />

    <!-- ==================== ÁREA DESPLAZABLE (SCROLLVIEW) ==================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerInsertarUsuarios"
        android:layout_above="@id/footerInsertarUsuarios"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTituloInsertarUsuarios"
            app:layout_constraintVertical_bias="0.15">

            <EditText
                android:id="@+id/txtCodigoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="Código:"
                android:textColorHint="#888888"
                android:inputType="text"
                android:background="@drawable/input_border"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/txtDni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="DNI:"
                android:textColorHint="#888888"
                android:inputType="number"
                android:background="@drawable/input_border"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/txtNombres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="Nombres:"
                android:textColorHint="#888888"
                android:inputType="text"
                android:background="@drawable/input_border"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/txtApellidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="Apellidos:"
                android:textColorHint="#888888"
                android:inputType="text"
                android:background="@drawable/input_border"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/txtEdad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="Edad"
                android:textColorHint="#888888"
                android:inputType="number"
                android:background="@drawable/input_border"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/txtRolMod"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Selecciona un Rol"
                app:hintTextColor="#FFFFFF"
                android:textColorHint="#B0B0B0"
                app:boxStrokeColor="#FFFFFF"
                app:endIconTint="#FFFFFF">

                <AutoCompleteTextView
                    android:id="@+id/txtrol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:editable="false"
                    android:inputType="none"
                    android:paddingStart="16dp"
                    android:paddingLeft="16dp"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <EditText
                android:id="@+id/txtUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="Username"
                android:textColorHint="#888888"
                android:inputType="text"
                android:background="@drawable/input_border"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/txtPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="Password"
                android:textColorHint="#888888"
                android:inputType="textPassword"
                android:background="@drawable/input_border"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:textColor="#000000"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/button27"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="btnInsertarUsuario"
                android:text="Insertar Usuario"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/button28"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="btnRegresar"
                android:text="Regresar" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/footerInsertarUsuarios"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#1E1B4B"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUsuarios"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Usuarios"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_people"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProductos"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Productos"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_inventory"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSedes"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Sedes"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_location_city"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Regresar"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

    </LinearLayout>

</RelativeLayout>