<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#29224E" android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Vista.frmCantidadProductos">

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cantidad Productos"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <GridLayout
        android:layout_width="320dp"
        android:layout_height="240dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView9"
        app:layout_constraintVertical_bias="0.3">

        <Button
            android:id="@+id/button24"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:onClick="btnIngresoProductos"
            android:text="Ingreso\nProductos"
            android:textSize="13sp" />

        <Button
            android:id="@+id/button25"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:onClick="btnSalidaProductos"
            android:text="Salida\nProductos"
            android:textSize="13sp" />

        <Button
            android:id="@+id/button26"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_margin="6dp"
            android:onClick="btnRegresar"
            android:text="Regresar"
            android:textSize="13sp" />

    </GridLayout>

    <LinearLayout
        android:id="@+id/footerOperarioAlmacen"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="#1F1A3D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- MOVIMIENTOS (ACTIVO EN ESTA PANTALLA) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIngresoSalida"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_marginVertical="6dp"
            android:layout_weight="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="Movimientos"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            app:backgroundTint="#3A3266"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_swap_horiz"
            app:iconGravity="top"
            app:iconPadding="1dp"
            app:iconSize="18dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <!-- SOLICITUDES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSolicitudes"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="Solicitudes"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            app:icon="@drawable/ic_note_add"
            app:iconGravity="top"
            app:iconPadding="1dp"
            app:iconSize="18dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <!-- REGRESAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="Regresar"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="top"
            app:iconPadding="1dp"
            app:iconSize="18dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>