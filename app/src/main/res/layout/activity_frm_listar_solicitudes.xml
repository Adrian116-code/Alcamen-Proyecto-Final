<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#29224E" android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Vista.frmListarSolicitudes">

    <TextView
        android:id="@+id/tvTituloListarSolicitudes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Listar Solicitudes"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloListarSolicitudes"
        app:layout_constraintVertical_bias="0.3">

        <ListView
            android:id="@+id/txtListarSolicitudes"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:divider="#44FFFFFF" android:dividerHeight="1dp"
            android:padding="8dp"
            android:clipToPadding="false"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/ListarSolicitud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="btnListarSolicitud"
            android:text="Listar Solicitudes"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/button49"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="btnRegresar"
            android:text="Regresar" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>