<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#29224E"
    tools:context=".Vista.frmListarSolicitudes">

    <!-- Título de la vista -->
    <TextView
        android:id="@+id/tvTituloListarSolicitudes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Listar Solicitudes"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- RecyclerView en reemplazo del ListView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSolicitudes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/containerBotones"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloListarSolicitudes"
        tools:listitem="@layout/item_solicitud" />

    <!-- Contenedor para botones de acción -->
    <LinearLayout
        android:id="@+id/containerBotones"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/footerJefeAlmacen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
    </LinearLayout>

    <!-- Footer de navegación del Jefe de Almacén (Intacto) -->
    <LinearLayout
        android:id="@+id/footerJefeAlmacen"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="#1F1A3D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- SOLICITUDES (ACTIVO EN ESTA PANTALLA) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSolicitudes"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_marginVertical="6dp"
            android:layout_weight="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="Solicitudes"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            app:backgroundTint="#3A3266"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_assignment"
            app:iconGravity="top"
            app:iconPadding="1dp"
            app:iconSize="18dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <!-- PROVEEDORES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProveedores"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="Proveedores"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            app:icon="@drawable/ic_local_shipping"
            app:iconGravity="top"
            app:iconPadding="1dp"
            app:iconSize="18dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <!-- DESPACHO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDespacho"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="Despacho"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            app:icon="@drawable/ic_list_alt"
            app:iconGravity="top"
            app:iconPadding="1dp"
            app:iconSize="18dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <!-- REGRESAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="Regresar"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="top"
            app:iconPadding="1dp"
            app:iconSize="18dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>