<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#1E1B4B">

    <!-- ==================== HEADER ==================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/headerJefeAlmacen"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="#5C429B"
        app:title="Jefe Almacén"
        app:titleCentered="true"
        app:titleTextAppearance="@style/ToolbarTitleStyle"
        app:titleTextColor="@android:color/white" />

    <!-- ==================== CONTENIDO CENTRAL ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/footerJefeAlmacen"
        android:layout_below="@id/headerJefeAlmacen"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Jefe Almacén"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3">

            <!-- Fila 1 -->
            <Button
                android:id="@+id/btnGestionarProductos"
                android:layout_width="140dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Gestionar\nProductos" />

            <Button
                android:id="@+id/btnGestionarSolicitudes"
                android:layout_width="140dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Gestionar\nSolicitudes" />

            <!-- Fila 2 -->
            <Button
                android:id="@+id/btnGestionarProveedores"
                android:layout_width="140dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Gestionar\nProveedores" />

            <Button
                android:id="@+id/btnListarDespacho"
                android:layout_width="140dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Listar\nDespacho" />

            <!-- Fila 3: Botón Regresar abarcando ambas columnas -->
            <Button
                android:id="@+id/btnRegresarCentral"
                android:layout_width="296dp"
                android:layout_height="90dp"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_columnSpan="2"
                android:layout_gravity="center_horizontal"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Regresar" />

        </GridLayout>

    </LinearLayout>

    <!-- ==================== FOOTER (5 ICONOS) ==================== -->
    <LinearLayout
        android:id="@+id/footerJefeAlmacen"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#5C429B"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnProductos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Productos"
            android:src="@drawable/ic_inventory"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnSolicitudes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Solicitudes"
            android:src="@drawable/ic_assignment"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnProveedores"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Proveedores"
            android:src="@drawable/ic_local_shipping"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnDespacho"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Despacho"
            android:src="@drawable/ic_list_alt"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Regresar"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white" />

    </LinearLayout>

</RelativeLayout>