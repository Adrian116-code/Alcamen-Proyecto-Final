<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#1E1B4B">

    <!-- ==================== HEADER ==================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/headerOperarioAlmacen"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="#5C429B"
        app:title="Operario Almacén"
        app:titleCentered="true"
        app:titleTextAppearance="@style/ToolbarTitleStyle"
        app:titleTextColor="@android:color/white" />

    <!-- ==================== CONTENIDO CENTRAL ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/footerOperarioAlmacen"
        android:layout_below="@id/headerOperarioAlmacen"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Operario Almacén"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <!-- Fila 1 -->
            <Button
                android:id="@+id/btnIngresoSalidaProductos"
                android:layout_width="140dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Ingreso/Salida\nProductos" />

            <Button
                android:id="@+id/btnInsertarSolicitudes"
                android:layout_width="140dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Insertar\nSolicitudes" />

            <!-- Fila 2: Botón Regresar abarcando ambas columnas -->
            <Button
                android:id="@+id/btnRegresarCentral"
                android:layout_width="296dp"
                android:layout_height="90dp"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnSpan="2"
                android:layout_gravity="center_horizontal"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Regresar" />

        </GridLayout>

    </LinearLayout>

    <!-- ==================== FOOTER (3 ICONOS) ==================== -->
    <LinearLayout
        android:id="@+id/footerOperarioAlmacen"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#5C429B"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnIngresoSalida"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ingreso/Salida Productos"
            android:src="@drawable/ic_swap_horiz"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnSolicitudes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Insertar Solicitudes"
            android:src="@drawable/ic_note_add"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Regresar"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white" />

    </LinearLayout>

</RelativeLayout>