<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#1E1B4B">

    <!-- ==================== HEADER ==================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/headerOperarioAlmacen"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="#5C429B"
        app:title="Operario Almacén"
        app:titleCentered="true"
        app:titleTextAppearance="@style/ToolbarTitleStyle"
        app:titleTextColor="@android:color/white" />

    <!-- ==================== CONTENIDO CENTRAL ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/footerOperarioAlmacen"
        android:layout_below="@id/headerOperarioAlmacen"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Operario Almacén"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <!-- Fila 1 -->

            <!-- Fila 2: Botón Regresar abarcando ambas columnas -->

            <Button
                android:id="@+id/btnInsertarSolicitudes"
                android:layout_width="140dp"
                android:layout_height="100dp"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:textColor="@color/white"
                android:text="Insertar\nSolicitudes" />

            <Button
                android:id="@+id/btnRegresarCentral"
                android:layout_width="296dp"
                android:layout_height="90dp"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnSpan="2"
                android:layout_gravity="center_horizontal"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:textColor="@color/white"
                android:text="Regresar" />

            <Button
                android:id="@+id/btnIngresoSalidaProductos"
                android:layout_width="140dp"
                android:layout_height="100dp"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:textColor="@color/white"
                android:text="Ingreso/Salida\nProductos" />

        </GridLayout>

    </LinearLayout>

    <!-- ==================== FOOTER (3 ICONOS) ==================== -->
    <LinearLayout
        android:id="@+id/footerOperarioAlmacen"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="#1F1A3D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:paddingVertical="4dp">

        <!-- INGRESO / SALIDA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIngresoSalida"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="Movimientos"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            app:icon="@drawable/ic_swap_horiz"
            app:iconGravity="top"
            app:iconPadding="1dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <!-- INSERTAR SOLICITUDES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSolicitudes"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="Solicitudes"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            app:icon="@drawable/ic_note_add"
            app:iconGravity="top"
            app:iconPadding="1dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <!-- REGRESAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="Regresar"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="top"
            app:iconPadding="1dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

    </LinearLayout>

</RelativeLayout>