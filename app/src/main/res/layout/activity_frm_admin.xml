<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#1E1B4B">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/headerAdmin"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="#5C429B"
        app:title="Administración"
        app:titleCentered="true"
        app:titleTextColor="@android:color/white"
        app:titleTextAppearance="@style/ToolbarTitleStyle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerAdmin"
        android:layout_above="@id/footerAdmin"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Admin"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <Button
                android:id="@+id/btnGestionarUsuarios"
                android:layout_width="140dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Gestionar\nUsuarios"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/btnGestionarProductos"
                android:layout_width="140dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Gestionar\nProductos"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/btnGestionarSedes"
                android:layout_width="140dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Gestionar\nSedes"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/btnRegresarCentral"
                android:layout_width="140dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:backgroundTint="#5C429B"
                android:text="Regresar"
                android:textColor="@android:color/white"/>

        </GridLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/footerAdmin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#1E1B4B"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUsuarios"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Usuarios"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_people"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProductos"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Productos"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_inventory"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSedes"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Sedes"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_location_city"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Regresar"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="@android:color/white"
            app:textAllCaps="false" />

    </LinearLayout>

</RelativeLayout>